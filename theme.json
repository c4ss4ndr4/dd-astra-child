{
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": ["%","px","em","rem","vh","vw"]
    },
    "typography": {
      "customFontSize": true,
      "customLineHeight": true,
      "dropCap": true,
      "fontSizes": [
        {
          "size": "13px",
          "name": "Small",
          "slug": "small"
        },
        {
          "size": "20px",
          "name": "Medium",
          "slug": "medium"
        },
        {
          "size": "36px",
          "name": "Large",
          "slug": "large"
        },
        {
          "size": "42px",
          "name": "Extra Large",
          "slug": "x-large"
        }
      ]
    },
    "layout": {
      "contentSize": "var(--wp--custom--ast-content-width-size)",
      "wideSize": "var(--wp--custom--ast-wide-width-size)",
      "fullSize": "none"
    }
  },
  "styles": {
    "elements": {
      "link": {
        "typography": {
          "textDecoration": "none"
        }
      }
    }
  }
}
